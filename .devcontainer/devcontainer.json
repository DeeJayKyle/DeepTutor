{
  "name": "DeepTutor",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  // A local CPU model needs room; 4 cores / 16 GB is the smallest size that runs it comfortably.
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "containerEnv": {
    "DEEPTUTOR_HOME": "/workspaces/.deeptutor-home",
    "OLLAMA_MODELS": "/workspaces/.ollama-models",
    "DEEPTUTOR_LLM_MODEL": "qwen2.5:3b",
    "DEEPTUTOR_EMBED_MODEL": "nomic-embed-text"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "forwardPorts": [3782],
  "portsAttributes": {
    "3782": { "label": "DeepTutor", "onAutoForward": "openBrowser" },
    "8001": { "label": "DeepTutor API", "onAutoForward": "silent" },
    "11434": { "label": "Ollama", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/CODESPACES.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
