{
  "name": "DeepTutor",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "containerEnv": {
    "DEEPTUTOR_HOME": "/workspaces/.deeptutor-home"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "forwardPorts": [3782],
  "portsAttributes": {
    "3782": { "label": "DeepTutor", "onAutoForward": "openBrowser" },
    "8001": { "label": "DeepTutor API", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/CODESPACES.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
